[Unit]
Description=FaceGate-Linux background lock daemon
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=%h/.local/bin/facegate --monitor
Restart=always
RestartSec=3
# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
RuntimeDirectory=facegate
ReadWritePaths=%t/facegate %t %h/.config/facegate %h/.local/share/facegate %h/.local/share/applications
RestrictNamespaces=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
