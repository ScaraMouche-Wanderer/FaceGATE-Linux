[Unit]
Description=FaceGate-Linux background lock daemon

[Service]
ExecStart=%h/.local/bin/facegate --monitor
Restart=on-failure
RestartSec=2
# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.config/facegate %h/.local/share/facegate %h/.local/share/applications
RestrictNamespaces=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
